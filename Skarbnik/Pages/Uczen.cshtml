@page
@model Skarbnik.Pages.UczenModel
@{
}
<div class="container mt-4">
    <h1 class="mb-4">Zaległości uczniów</h1> <!-- Podsumowanie -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="card-title text-muted"> Łączna suma zaległości </h5>
            <h2 class="text-danger"> @Model.SumaWszystkichZaleglosci.ToString("N2") zł </h2>
        </div>
    </div> <!-- Lista uczniów -->
    <div class="card shadow-sm">
        <div class="card-header"> <strong>Lista uczniów</strong> </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Nazwisko</th>
                            <th class="text-center"> Niezapłacone wydatki </th>
                            <th class="text-end"> Suma zaległości </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var uczen in Model.Uczniowie)
                        {
                            <tr>
                                <td>@uczen.Nazwisko</td>
                                <td class="text-center"> @uczen.Liczba </td>
                                <td class="text-end @(uczen.Suma > 0 ? " text-danger fw-bold" : "text-success")"> @uczen.Suma.ToString("N2") zł </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="2">Razem</th>
                            <th class="text-end text-danger"> @Model.SumaWszystkichZaleglosci.ToString("N2") zł </th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>
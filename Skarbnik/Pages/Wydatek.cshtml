@page "{id:int}"
@using Skarbnik.Enums
@using Skarbnik.Extensions
@using System.Text.Json
@using System.Globalization

@model Skarbnik.Pages.WydatekModel

@{
    ViewData["Title"] = "Szczegóły wydatku";

    var uczniowie = Model.Uczniowie;

    int liczbaZaplaconych = uczniowie
        .Count(x => x.StanPlatnosc == StanPlatnosc.Zaplacono);

    int liczbaDoZaplaty = uczniowie
        .Count(x => x.StanPlatnosc == StanPlatnosc.DoZaplaty);

    int liczbaNieprzydzielonych = uczniowie
        .Count(x => x.StanPlatnosc == StanPlatnosc.Brak);

    decimal sumaZaplacona =
        liczbaZaplaconych * Model.WydatekDane.Kwota;

    decimal sumaDoZaplaty =
        liczbaDoZaplaty * Model.WydatekDane.Kwota;

    decimal sumaPrzypisana =
        sumaZaplacona + sumaDoZaplaty;

    var nazwyUczniow = uczniowie
        .Select(x => x.Nazwisko)
        .ToList();

    var kwotyUczniow = uczniowie
        .Select(x => x.StanPlatnosc == StanPlatnosc.Brak
            ? 0m
            : Model.WydatekDane.Kwota)
        .ToList();

    var statusyUczniow = uczniowie
        .Select(x => x.StanPlatnosc.ToString())
        .ToList();
}

<div id="glowny" class="container-fluid py-4">

    <!-- NAGŁÓWEK -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="text-muted small mb-1">
                <i class="bi bi-receipt me-1"></i>
                SKARBNIK / SZCZEGÓŁY WYDATKU
            </div>

            <h1 class="h3 fw-bold mb-2">
                @Model.WydatekDane.Nazwa
            </h1>

            <div class="text-muted">
                Kwota na ucznia:
                <span class="fw-bold text-dark">
                    @Model.WydatekDane.Kwota.ToPln()
                </span>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            @if (User.IsLoggedIn())
            {
                <div>

                    <a id="aAdd"
                       asp-page="/DodajWydatek"
                       asp-route-id="@Model.WydatekDane.Id"
                       class="btn btn-outline-primary">
                        <i class="bi bi-pencil-square me-1"></i>
                        Edytuj
                    </a>

                    <button type="button"
                            id="btnUsun"
                            onclick="usunWydatek()"
                            class="btn btn-outline-danger">
                        <i class="bi bi-trash3 me-1"></i>
                        Usuń wydatek
                    </button>
                    <button type="button"
                            id="btnAddAll"
                            onclick="addAll()"
                            class="btn btn-outline-danger">

                        Dodaj dla wszystkich
                    </button>
                </div>
            }

            <button id="btnZapisz"
                    type="button"
                    class="btn btn-primary"
                    onclick="zapiszElementJakoJpg2('glowny', 'wydatek.jpg', ['btnZapisz', 'btnUsun', 'btnAddAll', 'aAdd'])">
                <i class="bi bi-image me-1"></i>
                Zapisz jako JPG
            </button>
        </div>
    </div>

    <!-- KARTY PODSUMOWANIA -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="text-muted small mb-2">
                                Kwota wydatku
                            </div>
                            <div class="fs-4 fw-bold">
                                @Model.WydatekDane.Kwota.ToPln()
                            </div>
                            <div class="small text-muted mt-1">
                                Na jednego ucznia
                            </div>
                        </div>
                        <div class="rounded-3 bg-primary-subtle text-primary p-3">
                            <i class="bi bi-receipt fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="text-muted small mb-2">
                                Zapłacono
                            </div>
                            <div class="fs-4 fw-bold text-success">
                                @sumaZaplacona.ToPln()
                            </div>
                            <div class="small text-muted mt-1">
                                @liczbaZaplaconych uczniów
                            </div>
                        </div>
                        <div class="rounded-3 bg-success-subtle text-success p-3">
                            <i class="bi bi-check-circle fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="text-muted small mb-2">
                                Do zapłaty
                            </div>
                            <div class="fs-4 fw-bold text-danger">
                                @sumaDoZaplaty.ToPln()
                            </div>
                            <div class="small text-muted mt-1">
                                @liczbaDoZaplaty uczniów
                            </div>
                        </div>
                        <div class="rounded-3 bg-danger-subtle text-danger p-3">
                            <i class="bi bi-clock-history fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="text-muted small mb-2">
                                Nieprzydzieleni
                            </div>
                            <div class="fs-4 fw-bold text-warning">
                                @liczbaNieprzydzielonych
                            </div>
                            <div class="small text-muted mt-1">
                                Uczniowie bez przypisania
                            </div>
                        </div>
                        <div class="rounded-3 bg-warning-subtle text-warning p-3">
                            <i class="bi bi-person-plus fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>



    <!-- LISTA UCZNIÓW -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-body py-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-list-check me-2 text-primary"></i>
                    Lista uczniów
                </h5>

                <span class="badge text-bg-secondary">
                    Razem: @Model.Uczniowie.Count
                </span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 60px;">Lp.</th>
                        <th>Uczeń</th>
                        <th>Status płatności</th>
                        <th>Data zapłaty</th>
                        <th>Detale</th>
                        <th class="text-center">Akcja</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!uczniowie.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <i class="bi bi-people fs-1 text-muted"></i>
                                <div class="fw-semibold mt-2">
                                    Brak uczniów
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        var lp = 0;

                        @foreach (var uczen in uczniowie)
                        {
                            lp++;

                            <tr>
                                <td class="ps-4 text-muted">@lp</td>

                                <td class="fw-semibold">
                                    <i class="bi bi-person-circle text-secondary me-2"></i>
                                    <a asp-page="/UczenWydatki"
                                       asp-route-id="@uczen.UczenId"
                                       class="text-decoration-none fw-semibold">
                                        @uczen.Nazwisko
                                    </a>
                                </td>

                                <td>
                                    <button type="button"
                                            onclick="@(User.IsLoggedIn() ? $"zmianastatus('{uczen.UczenId}')" : "")"
                                            class="btn btn-sm rounded-pill px-3
                                                            @(uczen.StanPlatnosc == StanPlatnosc.Zaplacono
                                                                                                                                        ? "btn-success"
                                                                                                                                        : uczen.StanPlatnosc == StanPlatnosc.DoZaplaty
                                                                                                                                            ? "btn-outline-danger"
                                                                                                                                            : "btn-outline-warning")">

                                @switch (uczen.StanPlatnosc)
                                        {
                                            case StanPlatnosc.Brak:
                                                <i class="bi bi-person-plus me-1"></i>
                                                <text>Nie przydzielono</text>
                                                break;

                                            case StanPlatnosc.DoZaplaty:
                                                <i class="bi bi-clock-history me-1"></i>
                                                <text>Do zapłaty</text>
                                                break;

                                            case StanPlatnosc.Zaplacono:
                                                <i class="bi bi-check-circle-fill me-1"></i>
                                                <text>Zapłacono</text>
                                                break;
                                        }
                                    </button>
                                </td>

                                <td class="text-muted text-nowrap">
                                    @(uczen.DataZaplaty?.ToTimeFull() ?? "—")
                                </td>
                                <td>
                                    <a asp-page="/Szczegoly"
                                       asp-route-id="@uczen.UczenWydatekId"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Szczegóły wydatku">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                                <td class="text-center">
                                    @if (uczen.StanPlatnosc != StanPlatnosc.Brak)
                                    {
                                        <button type="button"
                                                onclick="usun('@uczen.UczenId','@uczen.Nazwisko')"
                                                class="btn btn-sm btn-outline-danger"
                                                title="Usuń przypisanie"
                                                aria-label="Usuń przypisanie">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>

                <tfoot class="table-light">
                    <tr>
                        <td colspan="5" class="text-muted small py-3">
                            <i class="bi bi-info-circle me-1"></i>
                            Uczeń nieprzydzielony nie ma przypisania do tego wydatku.
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>

    </div>

    <!-- WYKRESY -->
    <div class="row g-3 mb-4">

        <!-- STATUSY -->
        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-pie-chart me-2 text-primary"></i>
                        Status płatności
                    </h5>

                    <p class="text-muted small">
                        Podział uczniów według statusu
                    </p>

                    <div class="chart-container chart-doughnut">
                        <canvas id="wykresStatusow"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- KWOTY -->
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-bar-chart-line me-2 text-primary"></i>
                        Rozliczenie wydatku
                    </h5>

                    <p class="text-muted small">
                        Łączna kwota zapłacona i pozostała do zapłaty
                    </p>

                    <div class="chart-container chart-amounts">
                        <canvas id="wykresKwot"></canvas>
                    </div>
                </div>
            </div>
        </div>



    </div>
</div>

<style>
    .chart-container {
        position: relative;
        width: 100%;
    }

    .chart-doughnut {
        height: 300px;
    }

    .chart-amounts {
        height: 300px;
    }

    #glowny .card {
        border-radius: 0.75rem;
    }

    #glowny .table th {
        white-space: nowrap;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const wydatekId = @Model.WydatekDane.Id;

    const liczbaZaplaconych = @liczbaZaplaconych;
    const liczbaDoZaplaty = @liczbaDoZaplaty;
    const liczbaNieprzydzielonych = @liczbaNieprzydzielonych;

    const kwotaNaUcznia = @Html.Raw(
                                JsonSerializer.Serialize(Model.WydatekDane.Kwota));

    const sumaZaplacona = @Html.Raw(
                                JsonSerializer.Serialize(sumaZaplacona));

    const sumaDoZaplaty = @Html.Raw(
                                JsonSerializer.Serialize(sumaDoZaplaty));

    const nazwyUczniow = @Html.Raw(
                                JsonSerializer.Serialize(nazwyUczniow));

    const kwotyUczniow = @Html.Raw(
                                JsonSerializer.Serialize(kwotyUczniow));

    const statusyUczniow = @Html.Raw(
                                JsonSerializer.Serialize(statusyUczniow));

    const kolorZielony = "#198754";
    const kolorCzerwony = "#dc3545";
    const kolorZolty = "#ffc107";

    const formatujPLN = wartosc =>
        Number(wartosc).toLocaleString("pl-PL", {
            style: "currency",
            currency: "PLN"
        });

    Chart.defaults.font.family = "Arial, sans-serif";
    Chart.defaults.plugins.legend.labels.usePointStyle = true;

    // 1. STATUSY PŁATNOŚCI
    new Chart(document.getElementById("wykresStatusow"), {
        type: "doughnut",
        data: {
            labels: [
                "Zapłacono",
                "Do zapłaty",
                "Nie przydzielono"
            ],
            datasets: [{
                data: [
                    liczbaZaplaconych,
                    liczbaDoZaplaty,
                    liczbaNieprzydzielonych
                ],
                backgroundColor: [
                    kolorZielony,
                    kolorCzerwony,
                    kolorZolty
                ],
                borderColor: "#ffffff",
                borderWidth: 3,
                hoverOffset: 8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: "65%",
            plugins: {
                legend: {
                    position: "bottom"
                },
                tooltip: {
                    callbacks: {
                        label: context =>
                            `${context.label}: ${context.raw}`
                    }
                }
            }
        }
    });

    // 2. ROZLICZENIE KWOT
    new Chart(document.getElementById("wykresKwot"), {
        type: "bar",
        data: {
            labels: [
                "Zapłacono",
                "Pozostało do zapłaty"
            ],
            datasets: [{
                label: "Kwota",
                data: [
                    sumaZaplacona,
                    sumaDoZaplaty
                ],
                backgroundColor: [
                    kolorZielony,
                    kolorCzerwony
                ],
                borderRadius: 8,
                maxBarThickness: 65
            }]
        },
        options: {
            indexAxis: "y",
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                x: {
                    beginAtZero: true,
                    ticks: {
                        callback: value =>
                            Number(value).toLocaleString("pl-PL") + " zł"
                    }
                }
            },
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    callbacks: {
                        label: context => formatujPLN(context.raw)
                    }
                }
            }
        }
    });

    // 3. STATUS KAŻDEGO UCZNIA
    const wykresUczniowElement =
        document.getElementById("wykresUczniow");

    if (wykresUczniowElement && nazwyUczniow.length > 0) {
        new Chart(wykresUczniowElement, {
            type: "bar",
            data: {
                labels: nazwyUczniow,
                datasets: [{
                    label: "Kwota",
                    data: kwotyUczniow,
                    backgroundColor: statusyUczniow.map(status => {
                        if (status === "Zaplacono") {
                            return kolorZielony;
                        }

                        if (status === "DoZaplaty") {
                            return kolorCzerwony;
                        }

                        return kolorZolty;
                    }),
                    borderRadius: 5,
                    maxBarThickness: 28
                }]
            },
            options: {
                indexAxis: "y",
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    x: {
                        beginAtZero: true,
                        suggestedMax: kwotaNaUcznia,
                        ticks: {
                            callback: value =>
                                Number(value).toLocaleString("pl-PL") + " zł"
                        }
                    },
                    y: {
                        ticks: {
                            autoSkip: false
                        }
                    }
                },
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        callbacks: {
                            label: context => {
                                const status = statusyUczniow[context.dataIndex];

                                let opis;

                                if (status === "Zaplacono") {
                                    opis = "Zapłacono";
                                } else if (status === "DoZaplaty") {
                                    opis = "Do zapłaty";
                                } else {
                                    opis = "Nie przydzielono";
                                }

                                return `${opis}: ${formatujPLN(context.raw)}`;
                            }
                        }
                    }
                }
            }
        });
    }

    // USUWANIE CAŁEGO WYDATKU
    function usunWydatek() {
        showGlobalConfirmModal(function () {
            postjson(
                `/api/baza/wydatek/${wydatekId}/usun`,
                {},
                function (wynik) {
                    console.log("Sukces:", wynik.message);
                    window.location.href = "/Index";
                },
                function (xhr, status, error) {
                    console.error("HTTP:", xhr.status);
                    console.error("Status:", status);
                    console.error("Błąd:", error);
                    console.error("Odpowiedź:", xhr.responseText);
                }
            );
        }, "Czy na pewno chcesz usunąć cały wydatek?");
    }

    // ZMIANA STATUSU PŁATNOŚCI
    function zmianastatus(uczenId) {
        postjson(
            `/api/baza/wydatek/${wydatekId}/uczen/${uczenId}/zmianastatus`,
            {},
            function (wynik) {
                console.log("Sukces:", wynik.message);
                load();
            },
            function (xhr, status, error) {
                console.error("HTTP:", xhr.status);
                console.error("Status:", status);
                console.error("Błąd:", error);
                console.error("Odpowiedź:", xhr.responseText);
            }
        );
    }
    //dodawanie dla wszystki
    function addAll() {
        showGlobalConfirmModal(function () {
            postjson(
                `/api/baza/wydatek/${wydatekId}/addall`,
                {},
                function (wynik) {
                    console.log("Sukces:", wynik.message);
                    load();
                },
                function (xhr, status, error) {
                    console.error("HTTP:", xhr.status);
                    console.error("Status:", status);
                    console.error("Błąd:", error);
                    console.error("Odpowiedź:", xhr.responseText);
                }
            );
        }, "Czy na pewno chcesz dodać przypisanie wydatku dla wszystkich uczniów?");
    }
    // USUWANIE PRZYPISANIA UCZNIA
    function usun(uczenId,nazwisko) {
        showGlobalConfirmModal(function () {
            postjson(
                `/api/baza/wydatek/${wydatekId}/uczen/${uczenId}/usun`,
                {},
                function (wynik) {
                    console.log("Sukces:", wynik.message);
                    load();
                },
                function (xhr, status, error) {
                    console.error("HTTP:", xhr.status);
                    console.error("Status:", status);
                    console.error("Błąd:", error);
                    console.error("Odpowiedź:", xhr.responseText);
                }
            );
        }, `Czy na pewno chcesz usunąć przypisanie wydatku dla ucznia ${nazwisko}?`);
    }
</script>
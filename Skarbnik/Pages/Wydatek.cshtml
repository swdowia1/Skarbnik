@page "{id:int}"
@using Skarbnik.Enums
@using Skarbnik.Extensions

@model Skarbnik.Pages.WydatekModel

@{
    ViewData["Title"] = "Szczegóły wydatku";

   
}

<div id="glowny" class="container-fluid py-4">

    <!-- Nagłówek wydatku -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="text-muted small mb-1">
                <i class="bi bi-receipt me-1"></i>
                SZCZEGÓŁY WYDATKU
            </div>

            <h2 class="fw-bold mb-1">@Model.WydatekDane.Nazwa</h2>

            <div class="text-muted">
                Kwota przypadająca na ucznia:
                <span class="fw-bold text-dark">
                    @Model.WydatekDane.Kwota.ToString("C")
                </span>
            </div>
        </div>

        <a asp-page="/Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Powrót do podsumowania
        </a>
        <a asp-page="/DodajWydatek"
           asp-route-id="@Model.WydatekDane.Id"
           class="btn btn-outline-primary">
            <i class="bi bi-pencil-square me-1"></i>
            Edytuj wydatek
        </a>
        <button type="button" onclick="usunWydatek()"
                class="btn btn-sm btn-outline-danger usun-przydzial"
                title="Usuń przypisanie"
                aria-label="Usuń przypisanie">
            Usuń wydatek
        </button>
        <button type="button"
                class="btn btn-primary"
                onclick="zapiszElementJakoJpg('glowny', 'wydatek.jpg')">
            Zapisz jako JPG
        </button>
    </div>

   
    <!-- Lista uczniów -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-people me-2"></i>
                    Lista uczniów
                </h5>

                <span class="badge bg-light text-dark border">
                    Razem: @Model.Uczniowie.Count
                </span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 60px;">Lp.</th>
                        <th>Uczeń</th>
                        <th>Status płatności</th>
                        <th>Data zapłaty</th>
                              <th class="text-center">Akcja</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Uczniowie.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <i class="bi bi-people fs-1 text-muted"></i>
                                <div class="fw-semibold mt-2">
                                    Brak uczniów
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        var lp = 0;

                        @foreach (var uczen in Model.Uczniowie)
                        {
                            lp++;

                            <tr>
                                <td class="ps-4 text-muted">@lp</td>

                                <td class="fw-semibold">
                                    <i class="bi bi-person-circle text-secondary me-2"></i>
                                    <a asp-page="/UczenWydatki"
                                       asp-route-id="@uczen.UczenId"
                                       class="text-decoration-none fw-semibold">
                                        @uczen.Nazwisko
                                    </a>
                                </td>

                                <td class="status-platnosci hand" onclick="zmianastatus('@uczen.UczenId')">
                                    @switch (uczen.StanPlatnosc)
                                    {
                                        case StanPlatnosc.Brak:
                                            <span class="badge rounded-pill bg-warning text-dark px-3 py-2">
                                                <i class="bi bi-person-plus me-1"></i>
                                                Nie przydzielono
                                            </span>
                                            break;

                                        case StanPlatnosc.DoZaplaty:
                                            <span class="badge rounded-pill bg-danger text-white px-3 py-2">
                                                <i class="bi bi-clock-history me-1"></i>
                                                Do zapłaty
                                            </span>
                                            break;

                                        case StanPlatnosc.Zaplacono:
                                            <span class="badge rounded-pill bg-success text-white px-3 py-2">
                                                <i class="bi bi-check-circle-fill me-1"></i>
                                                Zapłacono
                                            </span>
                                            break;
                                    }
                                </td>

                                <td class="text-muted">
                                    @(uczen.DataZaplaty?.ToTimeFull()?? "—")
                                </td>

                               

                                <td class="text-center">
                                    <button type="button" onclick="usun('@uczen.UczenId','@uczen.Nazwisko')"
                                            class="btn btn-sm btn-outline-danger usun-przydzial"
                                            title="Usuń przypisanie"
                                            aria-label="Usuń przypisanie">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>

            </table>
        </div>

        <div class="card-footer bg-white text-muted small py-3">
            <i class="bi bi-info-circle me-1"></i>
            Uczeń nieprzydzielony nie ma przypisania do tego wydatku.
        </div>

    </div>

</div>
<script>
    const wydatekId = @Model.WydatekDane.Id;
    function usunWydatek()
    {
       showGlobalConfirmModal(function () {
            postjson(
                `/api/baza/wydatek/${wydatekId}/usun`,
                {},
                function (wynik) {
                    console.log("Sukces:", wynik.message);
                    window.location.href = "/Index";
                },
                function (xhr, status, error) {
                    console.error("HTTP:", xhr.status);
                    console.error("Status:", status);
                    console.error("Błąd:", error);
                    console.error("Odpowiedź:", xhr.responseText);
                }
            );
        }, `Czy na pewno chcesz usunąć cały wydatek`);
    }
    function zmianastatus(uczenId) {
        postjson(
            `/api/baza/wydatek/${wydatekId}/uczen/${uczenId}/zmianastatus`,
            {},
            function (wynik) {
                console.log("Sukces:", wynik.message);
                load();
            },
            function (xhr, status, error) {
                console.error("HTTP:", xhr.status);
                console.error("Status:", status);
                console.error("Błąd:", error);
                console.error("Odpowiedź:", xhr.responseText);
            }
        );
    }
    
       function usun(uczenId, nazwisko) {
        showGlobalConfirmModal(function () {
            postjson(
                `/api/baza/wydatek/${wydatekId}/uczen/${uczenId}/usun`,
                {},
                function (wynik) {
                    console.log("Sukces:", wynik.message);
                    load();
                },
                function (xhr, status, error) {
                    console.error("HTTP:", xhr.status);
                    console.error("Status:", status);
                    console.error("Błąd:", error);
                    console.error("Odpowiedź:", xhr.responseText);
                }
            );
        }, `Czy na pewno chcesz usunąć przypisanie wydatku dla ucznia ${nazwisko}?`);
    }

</script>

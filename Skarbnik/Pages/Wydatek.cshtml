@page "{id:int}"

@model Skarbnik.Pages.WydatekModel

@{
    ViewData["Title"] = "Szczegóły wydatku";

    var zaplacono = Model.Uczniowie.Count(u =>
    u.CzyPrzydzielono && u.CzyZaplacono);

    var niezaplacono = Model.Uczniowie.Count(u =>
    u.CzyPrzydzielono && !u.CzyZaplacono);

    var nieprzydzielono = Model.Uczniowie.Count(u =>
    !u.CzyPrzydzielono);
}

<div class="container-fluid py-4">

    <!-- Nagłówek wydatku -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="text-muted small mb-1">
                <i class="bi bi-receipt me-1"></i>
                SZCZEGÓŁY WYDATKU
            </div>

            <h2 class="fw-bold mb-1">@Model.WydatekDane.Nazwa</h2>

            <div class="text-muted">
                Kwota przypadająca na ucznia:
                <span class="fw-bold text-dark">
                    @Model.WydatekDane.Kwota.ToString("C")
                </span>
            </div>
        </div>

        <a asp-page="/Podsumowanie/Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Powrót do podsumowania
        </a>
    </div>

    <!-- Karty podsumowania -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-success bg-opacity-10 text-success p-3">
                        <i class="bi bi-check-circle fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Zapłacono</div>
                        <div class="fs-3 fw-bold text-success">@zaplacono</div>
                        <div class="small text-muted">uczniów</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-danger bg-opacity-10 text-danger p-3">
                        <i class="bi bi-clock-history fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Nie zapłacono</div>
                        <div class="fs-3 fw-bold text-danger">@niezaplacono</div>
                        <div class="small text-muted">uczniów</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-warning bg-opacity-10 text-warning p-3">
                        <i class="bi bi-person-plus fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Nie przydzielono</div>
                        <div class="fs-3 fw-bold text-warning">@nieprzydzielono</div>
                        <div class="small text-muted">uczniów</div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Lista uczniów -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-people me-2"></i>
                    Lista uczniów
                </h5>

                <span class="badge bg-light text-dark border">
                    Razem: @Model.Uczniowie.Count
                </span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 60px;">Lp.</th>
                        <th>Uczeń</th>
                        <th>Status płatności</th>
                        <th>Data zapłaty</th>
                        <th class="text-end">Kwota</th>
                        <th class="text-center">Akcja</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Uczniowie.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <i class="bi bi-people fs-1 text-muted"></i>
                                <div class="fw-semibold mt-2">
                                    Brak uczniów
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        var lp = 0;

                        @foreach (var uczen in Model.Uczniowie)
                        {
                            lp++;

                            <tr>
                                <td class="ps-4 text-muted">@lp</td>

                                <td class="fw-semibold">
                                    <i class="bi bi-person-circle text-secondary me-2"></i>
                                    @uczen.Nazwisko
                                </td>

                                <td>
                                    @if (!uczen.CzyPrzydzielono)
                                    {
                                        <span class="badge rounded-pill bg-warning bg-opacity-25 text-dark border border-warning-subtle px-3 py-2">
                                            <i class="bi bi-dash-circle me-1"></i>
                                            Nie przydzielono
                                        </span>
                                    }
                                    else if (uczen.CzyZaplacono)
                                    {
                                        <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success-subtle px-3 py-2">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Zapłacono
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-danger bg-opacity-10 text-danger border border-danger-subtle px-3 py-2">
                                            <i class="bi bi-clock me-1"></i>
                                            Nie zapłacono
                                        </span>
                                    }
                                </td>

                                <td class="text-muted">
                                    @(uczen.DataZaplaty?.ToString("dd.MM.yyyy") ?? "—")
                                </td>

                                <td class="text-end fw-semibold">
                                    @if (uczen.CzyPrzydzielono)
                                    {
                                        @Model.WydatekDane.Kwota.ToString("C")
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td class="text-center">
                                    @if (!uczen.CzyPrzydzielono)
                                    {
                                        <a asp-page="/Wydatki/Przypisz"
                                           asp-route-uczenId="@uczen.UczenId"
                                           asp-route-wydatekId="@Model.WydatekDane.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Przydziel wydatek">
                                            <i class="bi bi-plus-lg me-1"></i>
                                            Przydziel
                                        </a>
                                    }
                                    else if (!uczen.CzyZaplacono)
                                    {
                                        <span class="text-muted small">
                                            Oczekuje na wpłatę
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-success small">
                                            <i class="bi bi-check2-all me-1"></i>
                                            Rozliczono
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>

            </table>
        </div>

        <div class="card-footer bg-white text-muted small py-3">
            <i class="bi bi-info-circle me-1"></i>
            Uczeń nieprzydzielony nie ma przypisania do tego wydatku.
        </div>

    </div>

</div>
<script>
    const wydatekId = @Model.WydatekDane.Id;
    console.log(`Wydatek ID: ${wydatekId}`);
</script>

@page
@model IndexModel
@using Skarbnik.Extensions
@{
    ViewData["Title"] = "Home page";

}
<div class="container-fluid mt-4">
    <h1 class="mb-4">Podsumowanie wydatków klasy</h1>
    <a asp-page-handler="TestExcel"
       class="btn btn-outline-success">
        <i class="bi bi-file-earmark-excel me-2"></i>
        Zapisz do piku XLS
    </a>
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th class="text-nowrap">Uczeń</th>
                    @foreach (var wydatek in Model.Podsumowanie.Wydatki)
                    {
                        <th title="@wydatek.Kwota" class="text-end text-nowrap nazwa-wydatku-pionowo">
                            <a asp-page="/Wydatek"
                               asp-route-id="@wydatek.Id"
                               class="text-decoration-none">
                                @wydatek.Nazwa
                            </a>
                        </th>
                    }
                    <th class="text-end text-nowrap">Nie zapłacone</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var uczen in Model.Podsumowanie.Uczniowie)
                {
                    <tr>
                        <td class="text-nowrap">
                            <a asp-page="/UczenWydatki"
                               asp-route-id="@uczen.Id"
                               class="text-decoration-none fw-semibold">
                                @uczen.Nazwisko
                            </a>
                        </td>
                        @foreach (var komorka in uczen.Wydatki)
                        {
                            <td title="@uczen.Nazwisko --> @komorka.Nazwa" class="text-end text-nowrap
                            @(komorka.Kwota.HasValue
                                                                                                        ? (!komorka.CzyZaplacono
                                                                                                            ? "text-danger fw-bold"
                                                                                                            : "table-success")
                                                                                                        : "table-warning")">

                        @if (komorka.Kwota.HasValue)
                                {
                                    <a asp-page="/Szczegoly"
                                       asp-route-id="@komorka.Id"
                                       class="text-reset text-decoration-none">
                                        @komorka.Kwota.Value.ToPln()
                                    </a>
                                }
                                else
                                {
                                    @*  <a asp-page="/Przypisz"
                                       asp-route-uczenId="@komorka.UczenId"
                                       asp-route-wydatekId="@komorka.WydatekId"
                                       class="btn btn-sm btn-outline-primary rounded-circle d-inline-flex align-items-center justify-content-center"
                                       style="width: 30px; height: 30px; font-size: 20px; line-height: 1; padding: 0;"
                                       title="Dodaj płatność"
                                       aria-label="Dodaj płatność">
                                        +
                                    </a> *@
                                    <a asp-page="/Przypisz"
                                       asp-route-uczenId="@komorka.UczenId"
                                       asp-route-wydatekId="@komorka.WydatekId"
                                       class="btn btn-sm btn-outline-primary rounded-circle">
                                        <i class="bi bi-plus-lg"></i>
                                    </a>
                                }

                            </td>
                        }
                        <td class="text-end text-nowrap @(uczen.SumaNiezaplacona > 0 ? " text-danger fw-bold" : "")"> @uczen.SumaNiezaplacona.ToPln() </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-light fw-bold">
                    <td>Razem</td> @foreach (var wydatek in Model.Podsumowanie.Wydatki) {
                    <td class="text-end text-nowrap"> @wydatek.Suma.ToPln() </td>
                                        }
                    <td class="text-end text-nowrap"> @Model.Podsumowanie.SumaWszystkichZaleglosci.ToPln() </td>
                </tr>
                <tr class="table-warning fw-bold">
                    <td>Nie zapłacone</td> @foreach (var wydatek in Model.Podsumowanie.Wydatki) {
                    <td class="text-end text-nowrap text-danger"> @wydatek.SumaNiezaplacona.ToPln() </td>
                                        }
                    <td class="text-end text-nowrap text-danger"> @Model.Podsumowanie.SumaWszystkichZaleglosci.ToPln() </td>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="text-muted small mt-2"> <span class="text-danger fw-bold">Czerwony kolor</span> oznacza niezapłacony wydatek. „Brak” oznacza, że wydatek nie dotyczy ucznia. </div>
</div>
<!-- Legenda tabeli przestawnej -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <div class="d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-info-circle-fill text-primary fs-5"></i>
            <h5 class="mb-0">Jak czytać tabelę?</h5>
        </div>

        <div class="d-flex flex-wrap gap-3 gap-lg-4">

            <div class="d-flex align-items-center gap-2">
                <span class="d-inline-flex align-items-center justify-content-center rounded bg-success-subtle text-success"
                      style="width: 36px; height: 36px;">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                </span>
                <div>
                    <div class="fw-semibold">Zapłacono</div>
                    <div class="small text-muted">Wpłata została odnotowana</div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="d-inline-flex align-items-center justify-content-center rounded bg-danger-subtle text-danger"
                      style="width: 36px; height: 36px;">
                    <i class="bi bi-clock-history fs-5"></i>
                </span>
                <div>
                    <div class="fw-semibold">Nie zapłacono</div>
                    <div class="small text-muted">Kwota do uregulowania</div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="d-inline-flex align-items-center justify-content-center rounded bg-warning-subtle text-warning-emphasis"
                      style="width: 36px; height: 36px;">
                    <i class="bi bi-dash-circle fs-5"></i>
                </span>
                <div>
                    <div class="fw-semibold">Nie dotyczy</div>
                    <div class="small text-muted">Wydatek nie jest przypisany uczniowi</div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="d-inline-flex align-items-center justify-content-center rounded border border-primary text-primary"
                      style="width: 36px; height: 36px;">
                    <i class="bi bi-plus-lg fs-5"></i>
                </span>
                <div>
                    <div class="fw-semibold">Przypisz wydatek</div>
                    <div class="small text-muted">Kliknij, aby przypisać wydatek uczniowi</div>
                </div>
            </div>

        </div>

        <hr class="my-3" />

        <div class="d-flex flex-wrap gap-2 align-items-center small text-muted">
            <i class="bi bi-lightbulb text-warning fs-5"></i>
            <span>
                Kliknij nazwę wydatku, aby zobaczyć szczegóły.
                Kliknij kwotę w tabeli, aby przejść do szczegółów przypisania.
                Kolumna <strong>Nie zapłacone</strong> pokazuje zaległości ucznia,
                a ostatnie wiersze przedstawiają sumy dla całej klasy.
            </span>
        </div>
    </div>
</div>
<script>
    function testDelete() {
      const studentId = 123;

    showGlobalConfirmModal(function () {
        console.log("Usuwanie ucznia o ID:", studentId);
    }, "Czy na pewno chcesz usunąć tego ucznia?");
    }
</script>
@page "{id:int}"
@model Skarbnik.Pages.UczenWydatkiModel
@using Skarbnik.Extensions

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">
                <i class="bi bi-person-lines-fill me-2"></i>
                @Model.UczenDane.Nazwisko
            </h1>
            <div class="text-muted">Wydatki i status płatności ucznia</div>
        </div>

        <a asp-page="/Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Powrót
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Suma przypisanych wydatków</div>
                    <div class="fs-3 fw-bold">
                        @Model.SumaWszystkich.ToPln()
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Pozostało do zapłaty</div>
                    <div class="fs-3 fw-bold text-danger">
                        @Model.SumaNiezaplaconych.ToPln()
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Liczba przypisanych wydatków</div>
                    <div class="fs-3 fw-bold">@Model.Wydatki.Count</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-light fw-bold">
            Lista wydatków
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Wydatek</th>
                        <th class="text-end">Kwota</th>
                        <th>Status</th>
                        <th>Data zapłaty</th>
                       <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Wydatki.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                Brak przypisanych wydatków.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var pozycja in Model.Wydatki)
                        {
                            <tr>
                                <td class="fw-semibold">
                                   
                                    <a asp-page="/Wydatek"
                                       asp-route-id="@pozycja.Wydatek.Id"
                                       class="text-decoration-none">
                                        @pozycja.Wydatek.Nazwa
                                    </a>
                                </td>

                                <td class="text-end text-nowrap">
                                    @pozycja.Wydatek.Kwota.ToPln()
                                </td>

                                <td>
                                    @if (pozycja.CzyZaplacono)
                                    {
                                        <span class="badge rounded-pill px-3 py-2"
                                              style="background-color: #198754; color: #fff; font-size: 0.85rem;">
                                            <i class="bi bi-check-circle-fill me-1"></i>
                                            Zapłacono
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill px-3 py-2"
                                              style="background-color: #dc3545; color: #fff; font-size: 0.85rem;">
                                            <i class="bi bi-exclamation-circle-fill me-1"></i>
                                            Do zapłaty
                                        </span>
                                    }
                                </td>

                                <td class="text-nowrap">
                                    @(pozycja.DataZaplaty?.ToTimeFull()?? "—")
                                </td>
                                <td class="text-center">
                                    <button type="button" onclick="usun('@pozycja.WydatekId','@pozycja.Wydatek.Nazwa')"
                                            class="btn btn-sm btn-outline-danger usun-przydzial"
                                            title="Usuń przypisanie"
                                            aria-label="Usuń przypisanie">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </td>
                              
                            </tr>
                        }
                    }
                </tbody>
                @if (Model.Wydatki.Any())
                {
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td>Razem</td>
                            <td class="text-end text-nowrap">
                                @Model.SumaWszystkich.ToPln()
                            </td>
                            <td colspan="3"></td>
                        </tr>
                    </tfoot>
                }
            </table>
            @if (Model.WydatkiNieprzypisane.Any())
            {
                <div class="card border-0 shadow-sm mt-4">
                    <div class="card-header bg-warning-subtle py-3">
                        <h5 class="mb-0">
                            <i class="bi bi-exclamation-circle me-2"></i>
                            Wydatki nieprzypisane uczniowi
                        </h5>
                        <small class="text-muted">
                            Wybierz wydatek, aby przypisać go temu uczniowi.
                        </small>
                    </div>

                    <div class="list-group list-group-flush">
                        @foreach (var nazwa in Model.WydatkiNieprzypisane)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center gap-3 py-3">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-receipt text-warning fs-5"></i>
                                    <span class="fw-semibold">@nazwa.Name</span>
                                    <button type="submit" class="btn btn-sm btn-outline-primary" onclick="dodaj('@nazwa.Id')">
                                        <i class="bi bi-plus-circle me-1"></i>
                                        Przypisz uczniowi
                                    </button>
                                </div>

                                <span class="badge text-bg-warning">Nieprzypisany</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
<script>
     const uczenId = @Model.UczenId;
     //[HttpPost("wydatek/{wydatekId:int}/uczen/{uczenId:int}/usun")]
     function usun(wydatekId, wydatekNazwa) {
           showGlobalConfirmModal(function () {
            postjson(
                `/api/baza/wydatek/${wydatekId}/uczen/${uczenId}/usun`,
                {},
                function (wynik) {
                    console.log("Sukces:", wynik.message);
                    window.location.href = "/Index";
                },
                function (xhr, status, error) {
                    console.error("HTTP:", xhr.status);
                    console.error("Status:", status);
                    console.error("Błąd:", error);
                    console.error("Odpowiedź:", xhr.responseText);
                }
            );
        }, `Czy na pewno chcesz usunąć przypisanie wydatku "${wydatekNazwa}" dla tego ucznia?`);
        
    }
    function dodaj(wydatekId) {
      // alert("Funkcja dodaj wywołana dla wydatku o ID: " + wydatekId + " i ucznia o ID: " + uczenId);
       postjson(
            `/api/baza/wydatek/${wydatekId}/uczen/${uczenId}/zmianastatus`,
            {},
            function (wynik) {
                console.log("Sukces:", wynik.message);
                load();
            },
            function (xhr, status, error) {
                console.error("HTTP:", xhr.status);
                console.error("Status:", status);
                console.error("Błąd:", error);
                console.error("Odpowiedź:", xhr.responseText);
            }
        );
    }
</script>
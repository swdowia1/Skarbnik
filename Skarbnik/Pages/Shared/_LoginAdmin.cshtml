@using Microsoft.AspNetCore.Authentication

@if (User.Identity?.IsAuthenticated != true)
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center gap-3">
        <span class="d-flex align-items-center gap-2">
            <i class="bi bi-shield-lock-fill fs-5"></i>
            Gdy chcesz edytować
            <i class="bi bi-arrow-right-circle-fill fs-5 text-primary"></i>
            <strong>Zaloguj jako administrator</strong>
        </span>

        <a asp-page="/Login" class="btn btn-primary btn-sm text-nowrap">
            <i class="bi bi-box-arrow-in-right me-1"></i>
            Zaloguj się
        </a>
    </div>
}
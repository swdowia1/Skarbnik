@using Skarbnik.Extensions
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Skarbnik</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Skarbnik.styles.css" asp-append-version="true" />
   
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
</head>
<body class="@(User.Identity?.IsAuthenticated == true ? "user-zalogowany" : "")">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light @(User.Identity?.IsAuthenticated == true ? "navbar-zalogowany" : "bg-white") border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Skarbnik</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                   
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Uczniowie">
                                <i class="bi bi-people"></i>
                                Uczniowie
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Dashboard">
                                <i class="bi bi-wallet2"></i>
                                Stan kasy
                            </a>
                        </li>

                        @if ((User.IsLoggedIn()))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-area=""
                                   asp-page="/DodajWydatek">
                                    <i class="bi bi-plus-circle"></i>
                                    Dodaj wydatek
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-area=""
                                   asp-page="/Niezaplacone">
                                    <i class="bi bi-exclamation-circle"></i>
                                    Niezapłacone
                                </a>
                            </li>

                            <li class="nav-item ms-sm-auto">
                                <form method="post" asp-page="/Logout" class="d-inline">
                                    <button type="submit" class="btn btn-logout">
                                        <i class="bi bi-box-arrow-right me-2"></i>
                                        Wyloguj się (@User.Identity.Name)
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-sm-auto">
                                <a class="nav-link text-dark"
                                   asp-area=""
                                   asp-page="/Login">
                                    <i class="bi bi-box-arrow-in-right"></i>
                                    Zaloguj się
                                </a>
                            </li>
                        }

                    </ul>
                 @if (ViewContext.RouteData.Values["page"]?.ToString() != "/Index")
{
    <a asp-page="/Index"
       class="btn btn-outline-secondary">
        Powrót do podsumowania
    </a>
}
                </div>
            </div>
        </nav>
    </header>
<div class="container-fluid px-3">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <div class="text-center small py-2">
        @{
#if DEBUG
        }
            <span class="text-danger fw-bold">
                <i class="bi bi-bug-fill"></i>
                Wersja DEBUG
            </span>
            <span class="text-muted">
                @System.IO.File.GetLastWriteTime(
                    System.Reflection.Assembly.GetExecutingAssembly().Location
                ).ToString("yyyy-MM-dd HH:mm")
            </span>
        @{
#else
        }
            <span class="text-muted">
                Wersja: @System.IO.File.GetLastWriteTime(
                    System.Reflection.Assembly.GetExecutingAssembly().Location
                ).ToString("yyyy-MM-dd HH:mm")
            </span>
        @{
#endif
        }
    </div>
</div>

    <div id="loading" class="waiting-panel" role="status" aria-live="polite" aria-hidden="true" style="display: none;">
        <div class="waiting-panel-card">
            <span class="waiting-panel-spinner" aria-hidden="true"></span>
            <span id="loadtextid" class="waiting-panel-text">Proszę czekać...</span>
        </div>
    </div>
   
    <div class="modal fade confirm-modal"
         id="globalConfirmModal"
         tabindex="-1"
         aria-labelledby="globalConfirmModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header border-0 pb-0">
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Zamknij">
                    </button>
                </div>

                <div class="modal-body text-center pt-0 px-4 pb-4">

                    <div class="confirm-modal-icon">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>

                    <h5 class="confirm-modal-title"
                        id="globalConfirmModalLabel">
                        Potwierdzenie
                    </h5>

                    <p class="confirm-modal-message mb-0">
                        Czy na pewno chcesz wykonać tę akcję?
                    </p>

                </div>

                <div class="modal-footer border-0 pt-0 px-4 pb-4">
                    <button type="button"
                            class="btn btn-confirm-cancel"
                            data-bs-dismiss="modal">
                        Anuluj
                    </button>

                    <button type="button"
                            class="btn btn-confirm-ok"
                            id="confirmModalOkBtn">
                        <i class="bi bi-check-lg me-1"></i>
                        Potwierdź
                    </button>
                </div>

            </div>
        </div>
    </div>
 

  @*   <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Skarbnik - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer> *@

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js?v=@DateTime.Now.Ticks"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

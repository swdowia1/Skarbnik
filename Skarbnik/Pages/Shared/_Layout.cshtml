<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Skarbnik</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Skarbnik.styles.css" asp-append-version="true" />
   
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Skarbnik</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                       @*  <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Start</a>
                        </li> *@
                       
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/DodajWydatek">Dodaj Wydatek</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid px-3">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
   
    <div class="modal fade confirm-modal"
         id="globalConfirmModal"
         tabindex="-1"
         aria-labelledby="globalConfirmModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header border-0 pb-0">
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Zamknij">
                    </button>
                </div>

                <div class="modal-body text-center pt-0 px-4 pb-4">

                    <div class="confirm-modal-icon">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>

                    <h5 class="confirm-modal-title"
                        id="globalConfirmModalLabel">
                        Potwierdzenie
                    </h5>

                    <p class="confirm-modal-message mb-0">
                        Czy na pewno chcesz wykonać tę akcję?
                    </p>

                </div>

                <div class="modal-footer border-0 pt-0 px-4 pb-4">
                    <button type="button"
                            class="btn btn-confirm-cancel"
                            data-bs-dismiss="modal">
                        Anuluj
                    </button>

                    <button type="button"
                            class="btn btn-confirm-ok"
                            id="confirmModalOkBtn">
                        <i class="bi bi-check-lg me-1"></i>
                        Potwierdź
                    </button>
                </div>

            </div>
        </div>
    </div>
 

  @*   <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Skarbnik - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer> *@

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js?v=@DateTime.Now.Ticks"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
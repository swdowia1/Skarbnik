@page
@model Skarbnik.Pages.DodajWydatekModel
<div class="container mt-4" style="max-width: 650px">
    <h1 class="mb-4">Dodaj wydatek</h1>

    <div class="card shadow-sm">
        <div class="card-body">
            <p class="text-muted">Nowy wydatek zostanie przypisany do wszystkich uczniów jako niezapłacony.</p>

            <div class="alert alert-info">Liczba uczniów: <strong>wstaw liczba</strong></div>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Nazwa" class="form-label"> Nazwa wydatku </label>

                    <input asp-for="Nazwa" class="form-control" placeholder="Np. Wycieczka szkolna" />

                    <span asp-validation-for="Nazwa" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Kwota" class="form-label"> Kwota na ucznia (zł) </label>

                    <input asp-for="Kwota"
                           type="number"
                           min="0.01"
                           step="0.01"
                           class="form-control"
                           placeholder="Np. 100,00" />

                    <span asp-validation-for="Kwota" class="text-danger"></span>
                </div>

                

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Zapisz wydatek</button>

                    <a asp-page="/Index" class="btn btn-outline-secondary"> Anuluj </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


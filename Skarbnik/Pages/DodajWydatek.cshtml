@page "{id:int?}"
@model Skarbnik.Pages.DodajWydatekModel

@{
    ViewData["Title"] = Model.CzyEdycja
        ? "Edycja wydatku"
        : "Dodaj wydatek";
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>

    <form method="post">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Nazwa" class="form-label">
                Nazwa wydatku
            </label>
            <input asp-for="Nazwa" class="form-control" />
            <span asp-validation-for="Nazwa"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Kwota" class="form-label">
                Kwota
            </label>
            <input asp-for="Kwota"
                   type="number"
                   step="0.01"
               
                   class="form-control"
                 />
            <span asp-validation-for="Kwota"
                  class="text-danger"></span>
        </div>

        @if (Model.CzyEdycja)
        {
            <button type="submit"
                    asp-page-handler="ZapiszEdycje"
                    class="btn btn-primary">
                <i class="bi bi-save me-1"></i>
                Zapisz zmiany
            </button>
        }
        else
        {
            <button type="submit"
                    asp-page-handler="Dodaj"
                    class="btn btn-primary">
                Dodaj wydatek
            </button>

            <button type="submit"
                    asp-page-handler="DodajDlaWszystkich"
                    class="btn btn-success">
                Dodaj i przypisz wszystkim
            </button>
        }

        <a asp-page="/Index" class="btn btn-outline-secondary">
            Anuluj
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}